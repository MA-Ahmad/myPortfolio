{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theme-studio-presence",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PresenceRoom" }]
  },
  // The free plan only offers SQLite-backed Durable Objects; the room only keeps bans and hourly counts.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] }],
  // Connection attempts per address per minute, counted in the Worker before the room is woken.
  "ratelimits": [{ "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "ALLOWED_ORIGINS": "https://mahmad.me,https://www.mahmad.me,http://localhost:3000"
  }
}
